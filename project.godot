; Godot 4 프로젝트 설정 파일.
; 에디터에서 프로젝트 설정을 바꾸면 이 파일이 자동으로 다시 쓰인다.
; 모바일 기준값의 근거는 docs/design/06_모바일_최적화.md 참고.

config_version=5

[application]

config/name="용의 전설 - 이무기의 탄생"
config/description="조선시대와 한국 설화를 배경으로 한 3D 모바일 육성 어드벤처 RPG"
config/version="0.1.0"
run/main_scene="res://scenes/main/boot.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=30
run/low_processor_mode=false

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
DataRegistry="*res://scripts/core/data_registry.gd"
GameState="*res://scripts/core/game_state.gd"
SaveSystem="*res://scripts/core/save_system.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
textures/default_filters/anisotropic_filtering_level=0
scaling_3d/scale=0.75
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.12, 1)
